venv/

# Archivos temporales de Python
__pycache__/
*.pyc
*.pyo
*.pyd

# Base de datos local de desarrollo
db.sqlite3

# Variables de entorno y secretos
.env

# Archivos de VS Code
.vscode/

# Archivos del sistema
.DS_Store
Thumbs.db

# Archivos estáticos recolectados para producción
staticfiles/

# Logs
*.log
"@ | Set-Content .gitignore